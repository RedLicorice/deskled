{
  "openapi": "3.1.0",
  "info": {
    "title": "DeskLED",
    "version": "1.5.0",
    "summary": "RGB desk light controller (ESP8266)",
    "description": "Controls an analog RGB LED strip: effects, colour, brightness, temporary effects and effect scripts, plus Wi-Fi, MQTT and firmware settings.\n\nAuthentication: every endpoint except /, /update (GET), /openapi.json and /api/login requires the admin account. Tools use HTTP Digest (user `admin`); the web UI uses a session cookie from /api/login. While the device runs its setup hotspot, authentication is skipped so the network can be configured.",
    "license": { "name": "MIT", "identifier": "MIT" }
  },
  "servers": [
    { "url": "/", "description": "The device itself" },
    { "url": "http://{host}", "description": "By hostname or IP", "variables": { "host": { "default": "deskled.local" } } }
  ],
  "tags": [
    { "name": "light", "description": "Effects, colour and brightness" },
    { "name": "scripts", "description": "User effect scripts" },
    { "name": "device", "description": "Device info, network, MQTT, updates" },
    { "name": "auth", "description": "Login and passwords" }
  ],
  "security": [{ "digest": [] }, { "session": [] }],
  "paths": {
    "/openapi.json": {
      "get": {
        "tags": ["device"],
        "summary": "This API description",
        "security": [],
        "operationId": "getOpenapi",
        "responses": { "200": { "description": "OpenAPI document", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/api/state": {
      "get": {
        "tags": ["light"],
        "summary": "Current state",
        "operationId": "getState",
        "responses": {
          "200": { "description": "State", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/State" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["light"],
        "summary": "Change the state",
        "description": "Only the fields present are changed. With `duration` the change is temporary: it is shown for that long, then the previous state returns and nothing is saved. Without it, the change is permanent and cancels any running temporary effect.",
        "operationId": "setState",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StateChange" },
          "examples": {
            "solidColour": { "summary": "Solid orange at half brightness", "value": { "mode": "solid", "color": "#ff8800", "brightness": 128 } },
            "alert": { "summary": "Red strobe for 10 seconds, then back", "value": { "mode": "strobe", "color": { "r": 255, "g": 0, "b": 0 }, "duration": 10000 } },
            "toggle": { "summary": "Toggle on/off", "value": { "toggle": true } }
          } } } },
        "responses": {
          "200": { "description": "New state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/State" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "put": {
        "tags": ["light"],
        "summary": "Change the state (same as POST)",
        "operationId": "putState",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StateChange" } } } },
        "responses": {
          "200": { "description": "New state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/State" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/state/temporary": {
      "delete": {
        "tags": ["light"],
        "summary": "Cancel a temporary effect",
        "description": "Restores the previous state at once. Does nothing if no temporary effect is running.",
        "operationId": "cancelTemporary",
        "responses": {
          "200": { "description": "State after cancelling", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/State" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/modes": {
      "get": {
        "tags": ["light"],
        "summary": "Available effects",
        "description": "Built-in effects followed by saved script names. Any of these is valid as `mode`.",
        "operationId": "listModes",
        "responses": {
          "200": { "description": "Effect names", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "string" },
            "examples": [["solid", "rgbfade", "breathe", "colorjump", "candle", "strobe", "fire"]] } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/info": {
      "get": {
        "tags": ["device"],
        "summary": "Device information",
        "operationId": "getInfo",
        "responses": {
          "200": { "description": "Info", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Info" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/scripts": {
      "get": {
        "tags": ["scripts"],
        "summary": "List effect scripts",
        "operationId": "listScripts",
        "responses": {
          "200": { "description": "Saved scripts", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Script" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["scripts"],
        "summary": "Create or replace a script",
        "description": "The formulas are compiled before saving; a syntax error is reported with its position. At most 12 scripts.",
        "operationId": "saveScript",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Script" } } } },
        "responses": {
          "200": { "description": "Saved", "content": { "application/json": { "schema": { "type": "object", "properties": { "saved": { "type": "string" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "tags": ["scripts"],
        "summary": "Delete a script",
        "operationId": "deleteScript",
        "parameters": [{ "name": "name", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Script name" }],
        "responses": {
          "200": { "description": "Deleted", "content": { "application/json": { "schema": { "type": "object", "properties": { "deleted": { "type": "string" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "description": "The script is the current effect; select another effect first", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/scripts/preview": {
      "post": {
        "tags": ["scripts"],
        "summary": "Try an unsaved script",
        "description": "Runs the formulas as a temporary effect without storing them.",
        "operationId": "previewScript",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/ScriptBody" }, { "type": "object", "properties": { "duration": { "type": "integer", "minimum": 1000, "maximum": 120000, "default": 15000, "description": "How long to show it, in milliseconds" } } }] } } } },
        "responses": {
          "200": { "description": "State while previewing", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/State" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/wifi/scan": {
      "get": {
        "tags": ["device"],
        "summary": "Scan for Wi-Fi networks",
        "description": "Scanning runs in the background: while `scanning` is true, call again in a second or so.",
        "operationId": "scanWifi",
        "responses": {
          "200": { "description": "Scan state or results", "content": { "application/json": { "schema": { "type": "object", "properties": {
            "scanning": { "type": "boolean" },
            "networks": { "type": "array", "items": { "type": "object", "properties": { "ssid": { "type": "string" }, "rssi": { "type": "integer" }, "secure": { "type": "boolean" } } } } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/wifi": {
      "post": {
        "tags": ["device"],
        "summary": "Save Wi-Fi settings",
        "description": "The device reboots about 1.5 s after replying and joins the saved network. Send `ip` (with `gateway`, `subnet`, optional `dns`) for a static address, or `ip: \"\"` for DHCP.",
        "operationId": "setWifi",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["ssid"], "properties": {
          "ssid": { "type": "string", "minLength": 1, "maxLength": 32 },
          "password": { "type": "string", "description": "Empty for an open network, otherwise 8-63 characters" },
          "hostname": { "type": "string", "description": "Letters, digits and dashes; also the mDNS name" },
          "ip": { "type": "string" }, "gateway": { "type": "string" }, "subnet": { "type": "string" }, "dns": { "type": "string" } } } } } },
        "responses": {
          "200": { "description": "Saved, rebooting", "content": { "application/json": { "schema": { "type": "object", "properties": { "saved": { "type": "boolean" }, "hostname": { "type": "string" }, "rebooting": { "type": "boolean" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "description": "Could not save", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "delete": {
        "tags": ["device"],
        "summary": "Forget the network",
        "description": "Clears the credentials and reboots into the setup hotspot.",
        "operationId": "clearWifi",
        "responses": {
          "200": { "description": "Cleared, rebooting", "content": { "application/json": { "schema": { "type": "object", "properties": { "cleared": { "type": "boolean" }, "rebooting": { "type": "boolean" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/mqtt": {
      "get": {
        "tags": ["device"],
        "summary": "MQTT settings",
        "operationId": "getMqtt",
        "responses": {
          "200": { "description": "Settings and connection state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MqttConfig" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["device"],
        "summary": "Change MQTT settings",
        "description": "Applied immediately, without a reboot. Omit `password` to keep the stored one. With MQTT enabled the device publishes Home Assistant discovery under `deskled/<hostname>/`.",
        "operationId": "setMqtt",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": {
          "enabled": { "type": "boolean" }, "host": { "type": "string" }, "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 1883 },
          "user": { "type": "string" }, "password": { "type": "string" }, "discovery_prefix": { "type": "string", "default": "homeassistant" } } } } } },
        "responses": {
          "200": { "description": "Settings after the change", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MqttConfig" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/login": {
      "get": {
        "tags": ["auth"],
        "summary": "Login challenge",
        "description": "Returns a single-use nonce valid for 5 minutes, for the web UI login.",
        "security": [],
        "operationId": "getLoginChallenge",
        "responses": { "200": { "description": "Challenge", "content": { "application/json": { "schema": { "type": "object", "properties": {
          "nonce": { "type": "string" }, "realm": { "type": "string" }, "user": { "type": "string" } } } } } } }
      },
      "post": {
        "tags": ["auth"],
        "summary": "Log in and get a session cookie",
        "description": "`response` = MD5(MD5(\"user:realm:password\") + \":\" + nonce), so the password never crosses the network. On success a `dl_session` cookie is set.",
        "security": [],
        "operationId": "login",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["nonce", "response"], "properties": {
          "nonce": { "type": "string" }, "response": { "type": "string" } } } } } },
        "responses": {
          "200": { "description": "Logged in", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "description": "Wrong password or reused nonce", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "Log out",
        "description": "Invalidates the session cookie of the caller.",
        "security": [],
        "operationId": "logout",
        "responses": { "200": { "description": "Logged out", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" } } } } } } }
      }
    },
    "/api/password": {
      "post": {
        "tags": ["auth"],
        "summary": "Change the admin password",
        "description": "Takes hashes rather than passwords: get a nonce from /api/login, then send `proof` = MD5(oldHA1 + \":\" + nonce), `ha1` = MD5(\"admin:DeskLED:<new>\") and `ota` = MD5(\"<new>\"). The device reboots and all sessions end. Length rules are enforced by the client.",
        "operationId": "setPassword",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["nonce", "proof", "ha1", "ota"], "properties": {
          "nonce": { "type": "string" }, "proof": { "type": "string" }, "ha1": { "type": "string" }, "ota": { "type": "string" } } } } } },
        "responses": {
          "200": { "description": "Changed, rebooting", "content": { "application/json": { "schema": { "type": "object", "properties": { "changed": { "type": "boolean" }, "rebooting": { "type": "boolean" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "description": "Current password is wrong", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/ap-password": {
      "post": {
        "tags": ["auth"],
        "summary": "Change the setup hotspot password",
        "description": "Used the next time the setup hotspot starts.",
        "operationId": "setApPassword",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["password"], "properties": {
          "password": { "type": "string", "minLength": 8, "maxLength": 63 } } } } } },
        "responses": {
          "200": { "description": "Changed", "content": { "application/json": { "schema": { "type": "object", "properties": { "changed": { "type": "boolean" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/reboot": {
      "post": {
        "tags": ["device"],
        "summary": "Reboot",
        "description": "Replies first, then reboots about a second later. Settings are saved before restarting.",
        "operationId": "reboot",
        "responses": {
          "200": { "description": "Rebooting", "content": { "application/json": { "schema": { "type": "object", "properties": { "rebooting": { "type": "boolean" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/update": {
      "post": {
        "tags": ["device"],
        "summary": "Install firmware",
        "description": "Upload `firmware.signed.bin`. Images that are unsigned, or signed with another key, are rejected. On success the device reboots into the new firmware.",
        "operationId": "updateFirmware",
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "properties": {
          "firmware": { "type": "string", "format": "binary" } } } } } },
        "responses": {
          "200": { "description": "Installed, rebooting", "content": { "application/json": { "schema": { "type": "object", "properties": { "updated": { "type": "boolean" }, "rebooting": { "type": "boolean" } } } } } },
          "400": { "description": "Rejected, e.g. signature verification failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "digest": { "type": "http", "scheme": "digest", "description": "HTTP Digest as user `admin`. Preferred for scripts and tools." },
      "session": { "type": "apiKey", "in": "cookie", "name": "dl_session", "description": "Session cookie from /api/login, used by the web UI." }
    },
    "responses": {
      "BadRequest": { "description": "Invalid input", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "Login required", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Error": { "type": "object", "properties": { "error": { "type": "string" } }, "required": ["error"] },
      "Rgb": { "type": "object", "properties": { "r": { "type": "integer", "minimum": 0, "maximum": 255 }, "g": { "type": "integer", "minimum": 0, "maximum": 255 }, "b": { "type": "integer", "minimum": 0, "maximum": 255 } }, "required": ["r", "g", "b"] },
      "ColourInput": {
        "description": "Colour as an object, an [r, g, b] array or a \"#RRGGBB\" string",
        "oneOf": [
          { "$ref": "#/components/schemas/Rgb" },
          { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "minItems": 3, "maxItems": 3 },
          { "type": "string", "pattern": "^#?[0-9a-fA-F]{6}$" }
        ]
      },
      "State": {
        "type": "object",
        "properties": {
          "on": { "type": "boolean" },
          "brightness": { "type": "integer", "minimum": 0, "maximum": 255 },
          "color": { "$ref": "#/components/schemas/Rgb" },
          "mode": { "type": "string", "description": "Built-in effect or script name" },
          "speed": { "type": "integer", "minimum": 1, "maximum": 255 },
          "transition": { "type": "integer", "minimum": 0, "maximum": 60000, "description": "Fade time in milliseconds" },
          "temporary": {
            "description": "Set while a temporary effect runs, otherwise null",
            "type": ["object", "null"],
            "properties": { "remaining": { "type": "integer", "description": "Milliseconds left" }, "restore": { "$ref": "#/components/schemas/State" } }
          }
        }
      },
      "StateChange": {
        "type": "object",
        "properties": {
          "on": { "type": "boolean" },
          "toggle": { "type": "boolean", "description": "Invert on/off" },
          "brightness": { "type": "integer", "minimum": 0, "maximum": 255 },
          "color": { "$ref": "#/components/schemas/ColourInput" },
          "mode": { "type": "string", "description": "Any name from /api/modes" },
          "speed": { "type": "integer", "minimum": 1, "maximum": 255 },
          "transition": { "type": "integer", "minimum": 0, "maximum": 60000 },
          "duration": { "type": "integer", "minimum": 1, "maximum": 3600000, "description": "Makes the change temporary, in milliseconds" }
        }
      },
      "ScriptBody": {
        "type": "object",
        "required": ["a", "b", "c"],
        "properties": {
          "space": { "type": "string", "enum": ["hsv", "rgb"], "default": "hsv", "description": "hsv: a = hue in degrees, b and c = saturation and value 0-1. rgb: a, b, c = 0-1." },
          "a": { "type": "string", "maxLength": 200 },
          "b": { "type": "string", "maxLength": 200 },
          "c": { "type": "string", "maxLength": 200 }
        },
        "description": "Formulas evaluated every frame. Variables: t (seconds), speed (1-255), k (speed/128), base colour cr, cg, cb (0-1) and ch, cs, cv. Functions: frac, tri, sq, pulse, wave, clamp, mix, smooth, noise, rand, sel, min, max, plus sin, cos, abs, pow, sqrt and the usual operators."
      },
      "Script": {
        "allOf": [
          { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "pattern": "^[a-z0-9_-]{1,20}$", "description": "Lower-case name, not a built-in effect" } } },
          { "$ref": "#/components/schemas/ScriptBody" }
        ]
      },
      "Info": {
        "type": "object",
        "properties": {
          "name": { "type": "string" }, "version": { "type": "string" }, "hostname": { "type": "string" }, "mac": { "type": "string" },
          "ap_mode": { "type": "boolean", "description": "True while the setup hotspot is running" },
          "ssid": { "type": "string" }, "ip": { "type": "string" }, "rssi": { "type": "integer" },
          "uptime": { "type": "integer", "description": "Milliseconds since boot" },
          "free_heap": { "type": "integer" }, "reset_reason": { "type": "string" },
          "mqtt_connected": { "type": "boolean" },
          "default_password": { "type": "boolean", "description": "True while the admin password is still the factory one" }
        }
      },
      "MqttConfig": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" }, "host": { "type": "string" }, "port": { "type": "integer" }, "user": { "type": "string" },
          "password_set": { "type": "boolean", "description": "Whether a password is stored; the password itself is never returned" },
          "discovery_prefix": { "type": "string" }, "connected": { "type": "boolean" },
          "base_topic": { "type": "string", "description": "Topics live under this prefix: state, set, speed/set, availability" }
        }
      }
    }
  }
}
